<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="payment_provider_easypay" model="payment.provider">
        <field name="name">EasyPay</field>
        <field name="code">easypay</field>
        <field name="allow_tokenization" eval="True" />
        <field
            name="payment_method_ids"
            eval="[(4, ref('payment.payment_method_card')), (4, ref('payment.payment_method_multibanco')), (4, ref('payment.payment_method_mbway'))]"
        />
        <field name="module_id" ref="base.module_payment_easypay" />
    </record>
</odoo>
