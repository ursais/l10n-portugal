<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!-- EasyPay Multibanco Payment Provider -->
    <record id="payment_provider_easypay_multibanco" model="payment.provider">
        <field name="name">EasyPay - Multibanco</field>
        <field name="code">easypay</field>
        <field name="easypay_payment_method">mb</field>
        <field name="module_id" ref="base.module_payment_easypay_mb" />
        <field
            name="payment_method_ids"
            eval="[(4, ref('l10n_pt_payment.payment_method_mb'))]"
        />
        <field
            name="image_128"
            type="base64"
            file="payment_easypay_mb/static/src/img/multibanco.png"
        />
    </record>

    <!-- EasyPay MB WAY Payment Provider -->
    <record id="payment_provider_easypay_mbway" model="payment.provider">
        <field name="name">EasyPay - MB WAY</field>
        <field name="code">easypay</field>
        <field name="easypay_payment_method">mbw</field>
        <field name="module_id" ref="base.module_payment_easypay_mb" />
        <field
            name="payment_method_ids"
            eval="[(4, ref('l10n_pt_payment.payment_method_mbway'))]"
        />
        <field
            name="image_128"
            type="base64"
            file="payment_easypay_mb/static/src/img/mbway.png"
        />
    </record>
</odoo>
