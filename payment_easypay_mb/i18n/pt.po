#. module: payment_easypay_mb
#: model_terms:ir.ui.view,arch_db:payment_easypay_mb.mbway_phone_input
msgid "9XXXXXXXX"
msgstr "9XXXXXXXX"

#. module: payment_easypay_mb
#: model_terms:ir.ui.view,arch_db:payment_easypay_mb.mbway_status
msgid ""
"<i class=\"fa fa-check-circle\"/> \n"
"                    Your order will be confirmed automatically once you approve the payment in your MB WAY app."
msgstr ""
"<i class=\"fa fa-check-circle\"/> \n"
"                    A sua encomenda será confirmada automaticamente assim que aprovar o pagamento na sua app MB WAY."

#. module: payment_easypay_mb
#: model_terms:ir.ui.view,arch_db:payment_easypay_mb.multibanco_reference
msgid ""
"<i class=\"fa fa-clock-o\"/> \n"
"                            <strong>Expiry Date:</strong>"
msgstr ""
"<i class=\"fa fa-clock-o\"/> \n"
"                            <strong>Data de Validade:</strong>"

#. module: payment_easypay_mb
#: model_terms:ir.ui.view,arch_db:payment_easypay_mb.mbway_status
msgid ""
"<i class=\"fa fa-clock-o\"/> \n"
"                    <strong>Important:</strong> You have 4 minutes to approve this payment request.\n"
"                    After that, the request will expire and you'll need to try again."
msgstr ""
"<i class=\"fa fa-clock-o\"/> \n"
"                    <strong>Importante:</strong> Tem 4 minutos para aprovar este pedido de pagamento.\n"
"                    Depois disso, o pedido expirará e terá de tentar novamente."

#. module: payment_easypay_mb
#: model_terms:ir.ui.view,arch_db:payment_easypay_mb.mbway_status
msgid ""
"<i class=\"fa fa-info-circle\"/> \n"
"                            <strong>Status:</strong>"
msgstr ""
"<i class=\"fa fa-info-circle\"/> \n"
"                            <strong>Estado:</strong>"

#. module: payment_easypay_mb
#: model_terms:ir.ui.view,arch_db:payment_easypay_mb.mbway_phone_input
msgid ""
"<i class=\"fa fa-info-circle\"/> \n"
"                    Make sure your MB WAY app is installed and activated on this phone number."
msgstr ""
"<i class=\"fa fa-info-circle\"/> \n"
"                    Certifique-se de que a sua app MB WAY está instalada e ativada neste número de telefone."

#. module: payment_easypay_mb
#: model_terms:ir.ui.view,arch_db:payment_easypay_mb.multibanco_reference
msgid ""
"<i class=\"fa fa-info-circle\"/> \n"
"                    Your order will be confirmed automatically once the payment is received.\n"
"                    This usually takes a few minutes."
msgstr ""
"<i class=\"fa fa-info-circle\"/> \n"
"                    A sua encomenda será confirmada automaticamente assim que o pagamento for recebido.\n"
"                    Isto normalmente demora alguns minutos."

#. module: payment_easypay_mb
#: model_terms:ir.ui.view,arch_db:payment_easypay_mb.multibanco_reference
msgid ""
"<i class=\"fa fa-laptop text-primary\"/> \n"
"                            <strong>Online Banking:</strong> Use the Multibanco payment option with the above details"
msgstr ""
"<i class=\"fa fa-laptop text-primary\"/> \n"
"                            <strong>Homebanking:</strong> Use a opção de pagamento Multibanco com os dados acima"

#. module: payment_easypay_mb
#: model_terms:ir.ui.view,arch_db:payment_easypay_mb.multibanco_reference
msgid ""
"<i class=\"fa fa-mobile text-primary\"/> \n"
"                            <strong>MB WAY:</strong> Use the \"Pay with Multibanco\" option in your MB WAY app"
msgstr ""
"<i class=\"fa fa-mobile text-primary\"/> \n"
"                            <strong>MB WAY:</strong> Use a opção \"Pagar com Multibanco\" na sua app MB WAY"

#. module: payment_easypay_mb
#: model_terms:ir.ui.view,arch_db:payment_easypay_mb.mbway_status
msgid "<i class=\"fa fa-mobile\"/> MB WAY Payment Request"
msgstr "<i class=\"fa fa-mobile\"/> Pedido de Pagamento MB WAY"

#. module: payment_easypay_mb
#: model_terms:ir.ui.view,arch_db:payment_easypay_mb.mbway_phone_input
msgid "<i class=\"fa fa-mobile\"/> Pay with MB WAY"
msgstr "<i class=\"fa fa-mobile\"/> Pagar com MB WAY"

#. module: payment_easypay_mb
#: model_terms:ir.ui.view,arch_db:payment_easypay_mb.multibanco_reference
msgid ""
"<i class=\"fa fa-university text-primary\"/> \n"
"                            <strong>ATM:</strong> Select \"Payments\" → \"Services/Purchases\" → Enter Entity and Reference"
msgstr ""
"<i class=\"fa fa-university text-primary\"/> \n"
"                            <strong>Multibanco:</strong> Selecione \"Pagamentos\" → \"Serviços/Compras\" → Introduza Entidade e Referência"

#. module: payment_easypay_mb
#: model_terms:ir.ui.view,arch_db:payment_easypay_mb.multibanco_reference
msgid "<i class=\"fa fa-university\"/> Multibanco Payment Reference"
msgstr "<i class=\"fa fa-university\"/> Referência de Pagamento Multibanco"

#. module: payment_easypay_mb
#: model_terms:ir.ui.view,arch_db:payment_easypay_mb.mbway_phone_input
msgid ""
"<small class=\"form-text text-muted\">\n"
"                        Enter your 9-digit Portuguese mobile number (without +351)\n"
"                    </small>"
msgstr ""
"<small class=\"form-text text-muted\">\n"
"                        Introduza o seu número de telemóvel português de 9 dígitos (sem +351)\n"
"                    </small>"

#. module: payment_easypay_mb
#: model_terms:ir.ui.view,arch_db:payment_easypay_mb.mbway_phone_input
msgid "<span class=\"input-group-text\">+351</span>"
msgstr "<span class=\"input-group-text\">+351</span>"

#. module: payment_easypay_mb
#: model_terms:ir.ui.view,arch_db:payment_easypay_mb.mbway_status
msgid "A payment request has been sent to your MB WAY app."
msgstr "Foi enviado um pedido de pagamento para a sua app MB WAY."

